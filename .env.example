# ─── Telegram ────────────────────────────────────────────────────────
# Получить токен у @BotFather
BOT_TOKEN=000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID чата саппорт-команды (в формате -100xxxxxxxxxx для супергрупп)
# Узнать через @getmyid_bot в нужном чате
SUPPORT_CHAT_ID=-100000000000

# ID чата куда бот шлёт карточки встреч и алерты
SALES_CHAT_ID=-100000000000

# ─── CalDAV (источник встреч) ────────────────────────────────────────
CALDAV_USERNAME=calendar-user@example.com
CALDAV_PASSWORD=change-me-strong-password
CALDAV_CALENDAR_URL=https://calendar.example.com/principals/user/calendars/abc123/

# ─── PostgreSQL ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=change-me-strong-password

# ─── HRBox (источник сотрудников, опционально) ───────────────────────
# Если не используешь HRBox — оставь пустыми, сотрудников придётся
# добавлять вручную через /emp_add из SUPPORT-чата
HRBOX_CLIENT_ID=
HRBOX_CLIENT_SECRET=

# ─── Опциональное ────────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=2
MORNING_DIGEST=07:00
LOGLEVEL=INFO
