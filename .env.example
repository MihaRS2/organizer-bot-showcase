# ─── Telegram ────────────────────────────────────────────────────────
# Get a token from @BotFather
BOT_TOKEN=000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Support-team chat ID (format -100xxxxxxxxxx for supergroups)
# Find it via @getmyid_bot inside the target chat
SUPPORT_CHAT_ID=-100000000000

# Chat ID where the bot posts meeting cards and alerts
SALES_CHAT_ID=-100000000000

# ─── CalDAV (meetings source) ────────────────────────────────────────
CALDAV_USERNAME=calendar-user@example.com
CALDAV_PASSWORD=change-me-strong-password
CALDAV_CALENDAR_URL=https://calendar.example.com/principals/user/calendars/abc123/

# ─── PostgreSQL ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=change-me-strong-password

# ─── HR system (employee source, optional) ───────────────────────────
# Leave empty if you don't use it — employees can be added manually
# via /emp_add from the SUPPORT chat
HRBOX_CLIENT_ID=
HRBOX_CLIENT_SECRET=

# ─── Optional ────────────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=2
MORNING_DIGEST=07:00
LOGLEVEL=INFO
